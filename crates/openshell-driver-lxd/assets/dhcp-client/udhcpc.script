#!/bin/sh
# SPDX-FileCopyrightText: 2026 Canonical Ltd.
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Minimal udhcpc bound/renew/deconfig event script for openshell-driver-lxd.

[ -z "$1" ] && echo "Error: should be called from udhcpc" && exit 1

case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface" 2>/dev/null || true
        ;;

    renew|bound)
        mask="${subnet:-24}"
        ip -4 addr add "$ip/$mask" dev "$interface" 2>/dev/null || true

        if [ -n "$router" ]; then
            for r in $router; do
                ip -4 route add default via "$r" dev "$interface" 2>/dev/null || true
                break
            done
        fi

        # Use the name servers the network hands out. The network's gateway
        # is not one on every network type: on OVN the router address answers
        # no DNS, and the servers offered are the uplink's.
        if [ -n "$dns" ]; then
            {
                [ -n "$domain" ] && printf 'search %s\n' "$domain"
                for server in $dns; do
                    printf 'nameserver %s\n' "$server"
                done
            } > /etc/resolv.conf.dhcp && mv /etc/resolv.conf.dhcp /etc/resolv.conf
        fi
        ;;
esac

exit 0
